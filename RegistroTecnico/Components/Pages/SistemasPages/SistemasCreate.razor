@page "/Sistemas/Create"
@inject SistemaService sistemaService
@inject NavigationManager navigationManager
@rendermode InteractiveServer

<EditForm Model="sistema" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />

    <div class="card shadow-lg border-0 rounded" style="background-color: #f8f9fa;">
        <div class="card-header bg-primary text-white text-center">
            <h3> <i class="fas fa-cogs"></i> Registro de Sistema</h3>
        </div>

        <div class="card-body">
            @* SistemaId *@
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="SistemaId" class="form-label">ID del Sistema:</label>
                    <InputNumber @bind-Value="sistema.SistemaId" TValue="int" class="form-control" disabled />
                </div>
            </div>

            @* Descripción *@
            <div class="mb-3">
                <label for="Descripcion" class="form-label">Descripción:</label>
                <InputText @bind-Value="sistema.Descripcion" class="form-control" />
                <ValidationMessage For="@(() => sistema.Descripcion)" />
            </div>

            @* Complejidad *@
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="Complejidad" class="form-label">Complejidad:</label>
                    <InputNumber @bind-Value="sistema.Complejidad" TValue="int" class="form-control" min="1" max="10" />
                    <ValidationMessage For="@(() => sistema.Complejidad)" />
                </div>
            </div>
        </div>

        <div class="card-footer bg-light d-flex justify-content-center mt-3">
            <div class="btn-group">
                <button type="button" class="btn btn-outline-primary ml-2" @onclick="Nuevo"><span class="bi bi-plus"></span> Nuevo</button>
                <button type="submit" class="btn btn-outline-success ml-2"><span class="bi bi-check-circle-fill"></span> Guardar</button>
                <a href="/Sistemas/Index" class="btn btn-outline-danger"><span class="bi bi-arrow-bar-left"></span> Retroceder</a>
            </div>
        </div>
    </div>
</EditForm>

@code {
    public Sistemas sistema { get; set; } = new Sistemas();
    private bool Existe = false;
    private string mensaje = string.Empty;

    public void Nuevo()
    {
        sistema = new Sistemas();
        Existe = false;
        mensaje = string.Empty;
    }

    public async Task<bool> Validar()
    {
        mensaje = string.Empty;

        if (string.IsNullOrWhiteSpace(sistema.Descripcion) || sistema.Complejidad <= 0)
        {
            mensaje = "Todos los campos son obligatorios.";
            return false;
        }

        return true;
    }

    public async Task Guardar()
    {
        if (!await Validar())
        {
            return;
        }

        var guardo = await sistemaService.Guardar(sistema);
        if (guardo)
        {
            mensaje = "Sistema creado exitosamente.";
            Nuevo();
        }
        else
        {
            mensaje = "Hubo un problema al guardar el sistema.";
        }
    }
}
