@page "/Sistemas/Edit/{SistemaId:int}"
@inject SistemaService sistemaService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer


<div class="card shadow-lg border-0 rounded" style="background-color: #f8f9fa;">
    <div class="card-header bg-primary text-white" style="text-align: center;">
        <h3> <i class="fas fa-clipboard-list"></i> Editar Sistemas</h3>
    </div>

    <div class="card-body">

        <div class="row">

            <div class="col-md-6 mb-3">
                <label for="SistemaId" class="form-label">SistemaId:</label>
                <div class="input-group">
                    <div style="width: 40%; height: 1em;">
                        <InputNumber @bind-Value="sistemas.SistemaId" class="form-control" style="font-size: 0.8em;" aria-describedby="BotonBuscar" />
                    </div>
                </div>
            </div>
        </div>

        <div class="mb-3">
            <label for="Descripcion" class="form-label">Descripción:</label>
            <InputText @bind-Value="sistemas.Descripcion" class="form-control" />
        </div>

        <div class="mb-3">
            <label for="Complejidad" class="form-label">Complejidad:</label>
            <InputNumber @bind-Value="sistemas.Complejidad" class="form-control" />
        </div>

    </div>

    <div class="card-footer bg-light d-flex justify-content-center mt-3">
        <div class="btn-group">
            <button type="button" class="btn btn-outline-primary ml-2" @onclick="Nuevo"><span class="bi bi-plus"></span> Nuevo </button>
            <button type="button" class="btn btn-outline-success ml-2" @onclick="Guardar"><span class="bi bi-check-circle-fill"></span> Guardar </button>
            <a type="button" href="/Sistemas/Index" class="btn btn-outline-danger"><span class="bi bi-arrow-bar-left"></span> Retroceder </a>
        </div>
    </div>
</div>



@code {
    [Parameter]
    public int? SistemaId { get; set; }
    public Sistemas sistemas { get; set; } = new Sistemas();
    private bool Existe = false;

    protected override async Task OnInitializedAsync()
    {
        if (SistemaId.HasValue)
        {
            sistemas.SistemaId = SistemaId.Value;
            await Buscar();
        }
    }

    public void Nuevo()
    {
        sistemas = new Sistemas();
        Existe = false;
    }

    public async Task Buscar()
    {
        var sistemaEncontrado = await sistemaService.Buscar(sistemas.SistemaId);

        if (sistemaEncontrado != null)
        {
            sistemas = sistemaEncontrado;
        }
    }

    public async Task<bool> Validar()
    {
        Existe = await sistemaService.ExistePorDescripcion(sistemas.Descripcion);
        return !Existe;
    }

    public async Task Guardar()
    {
        var guardo = await sistemaService.Modificar(sistemas);
        if (guardo)
        {
            Nuevo();
        }
    }

    public async Task Eliminar()
    {
        var eliminado = await sistemaService.Eliminar(sistemas.SistemaId);
        Nuevo();
    }
}
