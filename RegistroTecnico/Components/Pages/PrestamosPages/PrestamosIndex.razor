@page "/Prestamos/Index"
@inject PrestamosService prestamoService
@inject NavigationManager navigationManager
@rendermode InteractiveServer

<PageTitle>Préstamos</PageTitle>

<div class="border shadow-lg p-3 rounded">
    <div class="card-header bg-primary text-white text-center py-2 rounded">
        <h3 class="mb-0">Listado de Préstamos</h3>
    </div>

    <div class="card-body">
        <div class="row mb-3 align-items-end">
            <div class="col-md-3">
                <label for="Filtro" class="form-label">Filtrar por:</label>
                <select @bind="Filtro" class="form-select">
                    <option value="" selected disabled>Elija una opción</option>
                    <option value="Id">ID</option>
                    <option value="ClienteId">ID del Cliente</option>
                    <option value="Monto">Monto</option>
                    <option value="CantidadCuotas">Cantidad de Cuotas</option>
                    <option value="Balance">Balance</option>
                </select>
            </div>
            <div class="col-md-6">
                <label for="ValorFiltro" class="form-label">Búsqueda:</label>
                <div class="input-group">
                    <input @bind="ValorFiltro" class="form-control" placeholder="Buscar" />
                    <button @onclick="Buscar" class="btn btn-outline-primary" type="button">
                        <span class="bi bi-search"></span> Buscar
                    </button>
                </div>
            </div>
            <div class="col-md-3 text-end">
                <button @onclick="PantallaCrear" class="btn btn-success" type="button">
                    <span class="bi bi-plus-circle"></span> Crear
                </button>
            </div>
        </div>

        <table class="table table-bordered text-center">
            <thead class="bg-primary text-white">
                <tr>
                    <th>ID de Préstamo</th>
                    <th>ID de Cliente</th>
                    <th>Monto</th>
                    <th>Cantidad de Cuotas</th>
                    <th>Balance</th>
                    <th>Editar</th>
                    <th>Eliminar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var prestamo in ListaPrestamos)
                {
                    <tr>
                        <td>@prestamo.PrestamoId</td>
                        <td>@prestamo.ClienteId</td>
                        <td>@($"{prestamo.Monto:N2}")</td>
                        <td>@prestamo.CantidadCuotas</td>
                        <td>@($"{prestamo.Balance:N2}")</td>
                        <td>
                            <button type="button" class="btn btn-outline-success" @onclick="() => PantallaEditar(prestamo.PrestamoId)">
                                <span class="bi bi-pencil-square"></span>
                            </button>
                        </td>
                        <td>
                            <button type="button" class="btn btn-outline-danger" @onclick="() => PantallaEliminar(prestamo.PrestamoId)">
                                <span class="bi bi-trash"></span>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="card-footer text-end">
        <p><strong>Total de Préstamos: </strong>@ListaPrestamos.Count</p>
    </div>
</div>

@code {
    public List<Prestamos> ListaPrestamos { get; set; } = new List<Prestamos>();

    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        ListaPrestamos = await prestamoService.Listar(e => e.PrestamoId > 0);
    }

    public void PantallaCrear() => navigationManager.NavigateTo("/Prestamos/Create");

    public void PantallaEditar(int id)
    {
        navigationManager.NavigateTo($"/Prestamos/Edit/{id}");
    }

    public void PantallaEliminar(int id)
    {
        navigationManager.NavigateTo($"/Prestamos/Delete/{id}");
    }

    private async Task Buscar()
    {
        if (!string.IsNullOrWhiteSpace(ValorFiltro))
        {
            if (Filtro == "Id" && int.TryParse(ValorFiltro, out int prestamoId))
                ListaPrestamos = await prestamoService.Listar(e => e.PrestamoId == prestamoId);
            else if (Filtro == "ClienteId" && int.TryParse(ValorFiltro, out int clienteId))
                ListaPrestamos = await prestamoService.Listar(e => e.ClienteId == clienteId);
            else if (Filtro == "Monto" && decimal.TryParse(ValorFiltro, out decimal monto))
                ListaPrestamos = await prestamoService.Listar(e => e.Monto == monto);
            else if (Filtro == "CantidadCuotas" && int.TryParse(ValorFiltro, out int cantidadCuotas))
                ListaPrestamos = await prestamoService.Listar(e => e.CantidadCuotas == cantidadCuotas);
            else if (Filtro == "Balance" && decimal.TryParse(ValorFiltro, out decimal balance))
                ListaPrestamos = await prestamoService.Listar(e => e.Balance == balance);
        }
        else
        {
            ListaPrestamos = await prestamoService.Listar(e => e.PrestamoId > 0);
        }
    }

    private async Task Restablecer()
    {
        ListaPrestamos = await prestamoService.Listar(e => e.PrestamoId > 0);
        Filtro = string.Empty;
        ValorFiltro = string.Empty;
    }
}