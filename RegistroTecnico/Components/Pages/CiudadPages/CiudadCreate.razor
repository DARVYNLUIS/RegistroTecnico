@page "/Ciudad/Create"
@using RegistroTecnico.Services
@using RegistroTecnico.Models
@inject CiudadService ciudadService
@inject NavigationManager navigationManager
@rendermode InteractiveServer

<PageTitle>Crear Ciudad</PageTitle>

<EditForm Model="@Ciudad" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <h3><i class="fas fa-city"></i> Registro de Ciudad</h3>

    <div class="card-body">
        @* Nombre de la Ciudad *@
        <div class="mb-3">
            <label for="Nombre" class="form-label">Nombre de la Ciudad:</label>
            <InputText id="Nombre" @bind-Value="Ciudad.Nombre" class="form-control" />
            <ValidationMessage For="@(() => Ciudad.Nombre)" />
        </div>
    </div>

    <div class="card-footer bg-light d-flex justify-content-center mt-3">
        <div class="btn-group">
            <button type="button" class="btn btn-outline-primary ml-2" @onclick="Nuevo"><span class="bi bi-plus"></span> Nuevo </button>
            <button type="submit" class="btn btn-outline-success ml-2"><span class="bi bi-check-circle-fill"></span> Guardar </button>
            <a href="/Ciudad/Index" class="btn btn-outline-danger ml-2"><span class="bi bi-arrow-bar-left"></span> Retroceder </a>
        </div>
    </div>
</EditForm>

@code {
    public Ciudad Ciudad { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Ciudad = new Ciudad();
    }

    public void Nuevo()
    {
        Ciudad = new Ciudad();
    }

    public async Task Guardar()
    {
        try
        {
            if (Ciudad == null)
            {
                throw new InvalidOperationException("El objeto Ciudad no está inicializado.");
            }

            bool guardo = await ciudadService.Guardar(Ciudad);
            if (guardo)
            {
                Nuevo(); 
                navigationManager.NavigateTo("/Ciudad/Index"); 
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al guardar la ciudad: {ex.Message}");
        }
    }
}
